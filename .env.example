VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# App Check (reCAPTCHA v3). Public site key from Firebase Console -> App Check
# (register the web app with the reCAPTCHA v3 provider). Leave blank to disable
# App Check. Safe to commit — it's a public key like the API key above.
VITE_RECAPTCHA_SITE_KEY=
# Optional: App Check debug token for local dev / testing against an enforced
# project (Firebase Console -> App Check -> Manage debug tokens). Never in prod.
VITE_APPCHECK_DEBUG_TOKEN=
