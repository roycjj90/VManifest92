rules_version = '2';

// Hardened rules. Publish via Firebase Console → Firestore → Rules.
//
// VManifest 92 has ONE admin level: an admin sees and seats the whole battalion,
// and everyone else is a rider who sees their own seat. isAdmin() and
// isSuperAdmin() both survive because this file and src/App.jsx string-match the
// pair; in practice an admin is always both.
//
// The shape of the app in one line: a rider reads seats/<their id> and their own
// company's roster, and NOTHING else. Manifests are admin-only.
//
// Conventions this file depends on (must match src/App.jsx exactly):
//   synthetic email  = acc_<accountId>@vmanifest92.local      (authEmailScheme 'a')
//                    = acc_<accountId>_rN@vmanifest92.local   (      + authEmailVersion N >= 1)
//   legacy form      = username@vmanifest92.local             (authEmailScheme absent/'u')
//                    = username_rN@vmanifest92.local          (authEmailVersion N >= 1)
//   users/{uid}      = { accountId, groupId, companyId, isAdmin, isSuperAdmin }
//   accounts reads are LOCKED DOWN (super admin / own-group admin / self). The
//   pre-auth login lookup that used to need open reads now goes through
//   authIndex, which carries no personal data — see that block below.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myMirror() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && myMirror().isAdmin == true;
    }

    function isSuperAdmin() {
      return signedIn() && myMirror().isSuperAdmin == true;
    }

    function isSelfAccount(accountId) {
      return signedIn() && myMirror().accountId == accountId;
    }

    // A few legacy docs stored authEmailVersion as a string; tolerate both
    // types (the client normalizes to a number on every successful linkage).
    function versionSuffix(v) {
      return (v == null || v == 0 || v == '0' || v == '')
        ? ''
        : ('_r' + (v is string ? v : string(v)));
    }

    // The synthetic email the account's CURRENT stored state maps to. Claims
    // are matched against stored state — never against request.resource — so a
    // claimant can't choose the version they authenticate as.
    //
    // Two schemes, selected by the account's own authEmailScheme field:
    //   'a'          -> acc_<accountId>  (current)
    //   absent / 'u' -> <username>       (legacy)
    // Login IDs are phone numbers, so a username-derived address would put every
    // member's number into the Firebase Auth user list and into the public
    // signUp endpoint's "email already in use" response — an existence oracle
    // for any number an attacker cares to try. The account doc id is opaque and
    // already public via authIndex, so keying on it leaks nothing new.
    //
    // Absent defaults to the legacy branch, which is what makes this block safe
    // to publish BEFORE the client that writes the field: existing accounts are
    // evaluated exactly as they are today until they migrate.
    function expectedAuthEmail(accountId, accData) {
      // .get(...): a never-versioned account has no authEmailVersion field, and
      // reading a missing field raises and denies (incident #3). Absent = 0.
      // .lower() is load-bearing: Firebase Auth normalizes the entire address, so
      // a mixed-case Firestore auto-id comes back lowercased in the token and would
      // never equal the raw id. Mirrors accountAuthEmail in src/App.jsx.
      return (accData.get('authEmailScheme', 'u') == 'a' ? ('acc_' + accountId.lower()) : accData.username)
        + versionSuffix(accData.get('authEmailVersion', 0)) + '@vmanifest92.local';
    }

    // Linking a Firebase Auth uid to an account (first migration, or re-claim
    // after an admin password reset rotated the version). Requiring the Auth
    // token's email to equal the account's expected synthetic email is what
    // stops an arbitrary signed-in uid from claiming someone else's account —
    // Firebase's signUp endpoint is public, so "has some authenticated uid" is
    // free for an attacker; "registered this exact reserved email first" is the
    // narrowest test available without a server. Residual squatting risk on
    // never-migrated accounts is documented in the plan doc.
    //
    // The expected email is deliberately checked against BOTH the stored state
    // and the proposed state, and required to be equal: this allows linking at
    // the current version (and normalizing its stored type) but forbids ever
    // changing the version through this path. Legitimate version bumps already
    // happen through authorized writes elsewhere (self via isSelfAccount in
    // changeMyPassword, admin via isAdmin in setAccountPassword) — anchoring a
    // claim to a version the client itself just chose would let an attacker who
    // reads the (world-readable) current version pre-register the next one's
    // synthetic email and win the claim before the real owner ever logs in.
    // 'password' is allowed in the diff so this same write can retire the
    // legacy hash once Auth owns the credential (see writeIdentityDocs in
    // src/App.jsx), but only ever by REMOVING it — the explicit `!('password'
    // in ...)` check means this path can never be used to set or preserve a
    // password value, only delete one.
    // 'authEmailScheme' is deliberately absent from the hasOnly list: flipping an
    // account from the legacy address to the acc_ one changes what this function
    // expects, so allowing it here would hand the claimant the same choice the
    // version check above denies them. The equality check would reject the flip
    // anyway (the two addresses can never be equal) — leaving the key out makes
    // that explicit. The scheme is flipped afterwards, by an already-authorized
    // self-write under isSelfAccount, once the caller demonstrably owns the
    // account (see reconcileAuthEmailScheme in src/App.jsx).
    function isClaimingAuthUid(accountId) {
      return signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.auth.token.email == expectedAuthEmail(accountId, resource.data)
        && expectedAuthEmail(accountId, request.resource.data) == expectedAuthEmail(accountId, resource.data)
        && !('password' in request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['authUid', 'authEmailVersion', 'password']);
    }

    // Failed-login lockout tracking must work while unauthenticated — that's
    // its whole purpose. Scoped so it can only ever increment the counter and
    // set a lockout timestamp; useless for anything but self-limiting denial.
    function isLockoutBump() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['failedAttempts', 'lockedUntil'])
        && request.resource.data.failedAttempts == resource.data.get('failedAttempts', 0) + 1;
    }

    match /accounts/{accountId} {
      // Read lockdown (the exposure closure). Pre-auth lookups now go through
      // the public authIndex, so accounts no longer needs a world-readable path:
      //   - super admin: every account (members list uses an unfiltered query)
      //   - regular admin: only their own group (query is where groupId == theirs)
      //   - member: only their own doc (query is where __name__ == self)
      // .get(...) is used for the same missing-field-safety reason as elsewhere
      // (incident #3). Requires the authIndex-reading client to be DEPLOYED first
      // — the old client read accounts pre-auth and would break under this.
      allow read: if isSuperAdmin()
                  || (isAdmin() && myMirror().groupId == resource.data.get('groupId', ''))
                  || (signedIn() && resource.data.get('authUid', '') == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (isSelfAccount(accountId)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['isAdmin', 'isSuperAdmin', 'groupId']))
                    || (!signedIn() && isLockoutBump())
                    || isClaimingAuthUid(accountId);
      allow delete: if isAdmin();
    }

    // Public pre-auth lookup index: username(lowercased) -> { accountId,
    // authEmailVersion, failedAttempts, lockedUntil, password? }. This is what
    // lets accounts itself be locked down — the login bootstrap must read some
    // doc before any auth session exists, so that read happens HERE, on a doc
    // that deliberately carries NO personal data (no display name, group, role,
    // or phone-as-a-field). `get` is open; `list` is intentionally NOT granted,
    // so the collection can't be enumerated the way world-readable accounts can.
    // The residual pre-migration exposure (a legacy SHA-256 hash readable by
    // someone who already knows the username) is identical to today's accounts
    // exposure and disappears the moment that account migrates.
    //
    // Publishing this block is zero-risk to current operation: it only grants
    // access to a brand-new collection nothing reads yet. It must go live BEFORE
    // the client that reads/writes authIndex is deployed.
    match /authIndex/{uname} {
      // Caller owns the account this index points at — proven via the account
      // doc's own authUid, NOT the users/{uid} mirror (which doesn't exist yet
      // during a first-time migration, when this write first fires).
      function idxSelf(accountId) {
        return signedIn()
          && get(/databases/$(database)/documents/accounts/$(accountId)).data.get('authUid', '') == request.auth.uid;
      }
      // Unauthenticated failed-login lockout bump — mirror of accounts'
      // isLockoutBump; can only ever increment the counter / set a lockout stamp.
      function idxLockoutBump() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['failedAttempts', 'lockedUntil'])
          && request.resource.data.failedAttempts == resource.data.get('failedAttempts', 0) + 1;
      }

      allow get: if true;                 // single-doc login lookup; no list → no enumeration
      allow create: if isAdmin() || idxSelf(request.resource.data.accountId);
      allow update: if isAdmin()
                    || idxSelf(resource.data.accountId)
                    || (!signedIn() && idxLockoutBump());
      allow delete: if isAdmin() || idxSelf(resource.data.accountId);
    }

    // Auth-role mirror — the substitute for custom claims (Admin SDK only).
    // Security-critical: isAdmin()/isSelfAccount() read this. A self-created
    // mirror is only accepted once its account doc already names this uid in
    // authUid (see isClaimingAuthUid), and every field must byte-match that
    // account doc — nothing is client-asserted independently of it.
    match /users/{uid} {
      allow read: if signedIn();
      // Field access uses .get(key, default), NOT .data.key: an account doc that
      // predates a field (older accounts had no isSuperAdmin) would otherwise make
      // .data.<missing> raise and deny, which silently broke re-migration mirror
      // creation for those accounts (2026-07-04 incident #3 below).
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.accountId is string
        && get(/databases/$(database)/documents/accounts/$(request.resource.data.accountId)).data.get('authUid', '') == uid
        && request.resource.data.isAdmin ==
           get(/databases/$(database)/documents/accounts/$(request.resource.data.accountId)).data.get('isAdmin', false)
        && request.resource.data.isSuperAdmin ==
           get(/databases/$(database)/documents/accounts/$(request.resource.data.accountId)).data.get('isSuperAdmin', false)
        && request.resource.data.groupId ==
           (get(/databases/$(database)/documents/accounts/$(request.resource.data.accountId)).data.get('groupId', '') == null
             ? ''
             : get(/databases/$(database)/documents/accounts/$(request.resource.data.accountId)).data.get('groupId', ''));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // A group doc holds company-level settings: the reporting location, the ICT
    // period, the venue schedule, sections, and the platoon's own name/order.
    // Every screen that edits any of it is super-admin only as of #123, so this
    // matches the app rather than restricting it. isSuperAdmin() reads the same
    // users mirror isAdmin() already does — no extra billed get().
    // Basic admins still write rosters/{groupId} below; that one stays isAdmin().
    match /groups/{groupId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // Five documents naming the battalion's companies. Read by everyone signed in:
    // a platoon's company name appears on a rider's crew list, and hiding the list
    // of company NAMES protects nothing.
    match /companies/{companyId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Names-only personnel roster, one document per COMPANY, plus 'ATTACHED' (the
    // battalion-wide attached pool) and 'UNFILED' (platoons not yet under a company).
    // Six documents that carry every seatable person, so nobody has to read 500
    // account documents to draw a list. Carries no phone number, no password hash,
    // no account fields.
    //
    // An admin lists the whole collection; a member gets their own company's document
    // and nothing else. `list` is admin-only on purpose: a member reading one company
    // is their own unit, a member reading all six is the battalion's nominal roll.
    match /rosters/{companyId} {
      allow get: if isAdmin()
                 || (signedIn() && myMirror().get('companyId', '') == companyId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // The names of deleted personnel, kept so past attendance still reads back
    // correctly. A past day's "MC: 3" expands into three names resolved against
    // the current roster, so deleting an account would leave the count saying 3
    // while only two names appeared — and nothing else in the app holds that
    // name once the account doc is gone.
    //
    // ONE document (formerMembers/index) mapping accountId -> name, written in
    // the same batch as the deletion and read once per admin session by the
    // Count tab. A collection would have cost one read per departed person,
    // every session. Names only, admins only — the Count tab is admin-only.
    //
    // Additive and inert: nothing reads or writes it until the client that does
    // is deployed. It MUST go live first, though — the write shares a batch with
    // the account deletion, and a batch is all-or-nothing, so a client deployed
    // against un-published rules would fail every removal outright.
    match /formerMembers/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }


    match /groupFields/{fieldId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /accountFields/{fieldId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }



    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Lockdown — a super-admin switch that stops everyone else signing in, so a
    // roster can be imported and checked before anyone sees it. The login page
    // reads it with no Firebase Auth session yet, so `get` has to be open; the
    // doc holds one boolean and nothing else, and the same reasoning as
    // authIndex applies (get open, list left denied).
    //
    // Deliberately NOT settings/{docId}: that block grants write to any admin,
    // and rules OR together, so nothing placed under it could ever be
    // super-admin-only.
    match /appAccess/{docId} {
      allow get: if true;
      allow write: if isSuperAdmin();
    }


    // A rider's own seats, keyed by manifest id. This is the ONLY thing a non-admin
    // reads to find their vehicle: movements/ is admin-only and battalion-wide, so a
    // rider must never reach it, and everything they need is copied onto this document
    // instead.
    //
    // READ is their own document alone. WRITE is admin-only — unlike the attendanceSelf
    // block this replaces, a rider has no business writing here: nothing they do puts
    // them on a vehicle, and a writable seat is a rider who can seat himself.
    match /seats/{accountId} {
      allow read: if isAdmin() || isSelfAccount(accountId);
      allow write: if isAdmin();
    }


    // A vehicle manifest: vehicles, seat assignments, and (on an outfield) the
    // ADVANCE PARTY / MAIN BODY split. Battalion-wide by necessity — a convoy can
    // carry men from two companies — plus `movements/fleet`, the saved vehicle list
    // a new manifest is populated from, which holds no personal data at all.
    //
    // ADMIN-ONLY in both directions. Riders never read this: their own vehicle, role
    // and crew are copied onto their seats document, which they already listen to.
    // That is the whole reason a rider's app open costs one read no matter how big
    // the battalion gets — and why a manifest being readable by riders would undo it
    // as well as handing every rider the battalion's movements.
    match /movements/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }



    // One-account-per-device-per-day lock. Doc id is a random client-generated
    // deviceId held in localStorage; fields are { date, accountId, accountDisplay }.
    //
    // `read` used to be open to any signed-in user, which let ANY member list the
    // whole collection — a cross-group view of who logged in today and on which
    // device, in an app that otherwise scopes everything by group. Split into
    // get/list: the only caller that iterates this collection is the admin
    // Settings card, whose listener already sits behind `if (account.isAdmin)`
    // in src/App.jsx, so restricting `list` breaks nothing. A single-doc `get`
    // stays open to every signed-in user because login must read its own lock
    // before claiming it — and a deviceId is an unguessable random value, so
    // knowing the id is itself the authorization.
    //
    // create/update stay open for the same reason: login writes its own lock,
    // and the rule has no way to tie a client-generated deviceId back to the
    // caller. Forging a lock against a specific person would require guessing
    // their deviceId, which is not feasible.
    //
    // DELETE is still open — deliberately, and temporarily. Clearing a lock
    // defeats the entire anti-buddy-check-in control, so it belongs to admins
    // (clearDeviceLock, Admin tab). But the DEV quick-login buttons clear it as
    // a regular user so role switching never trips a lockout, and that call is
    // wrapped in a bare try/catch — tightening delete now would break testing
    // silently. Swap to `isAdmin()` in the same change that removes the dev
    // buttons (see the pre-launch checklist in CLAUDE.md).
    match /deviceLogins/{deviceId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if signedIn();
      allow delete: if signedIn();   // -> isAdmin() when the dev buttons go
    }
  }
}
